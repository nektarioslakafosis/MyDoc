@model MyDoc.Models.Appointment

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Appointment</h1>

<h3>Are you sure you want to delete this appointment?</h3>
<hr />

<dl class="row">
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.AppointmentDate</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Doctor</dt>
    <dd class="col-sm-9">
        @Model.Doctor.FirstName @Model.Doctor.LastName
        (@Model.Doctor.Specialty)
    </dd>

    <dt class="col-sm-3">Patient</dt>
    <dd class="col-sm-9">
        @(Model.Patient != null
                ? Model.Patient.FirstName + " " + Model.Patient.LastName
                : "-")
    </dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>