@model MyDoc.Models.AppointmentCancelVM
@using System.Globalization

@{
    ViewData["Title"] = "Ακύρωση Ραντεβού";

    var greekCulture =
        new CultureInfo("el-GR");
}

<section class="dashboard-page patient-cancel-page modern-cancel-page">
    <div class="container">

        <div class="action-page-shell action-page-shell-narrow">

            <a asp-controller="Appointments"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="appointment-back-link">
                ← Ραντεβού
            </a>

            <header class="action-page-header">
                <div>

                    <h1>Ακύρωση ραντεβού</h1>

                    <p>
                        Η ενέργεια είναι οριστική.
                    </p>
                </div>
            </header>

            <section class="modern-cancel-card">

                <div class="modern-appointment-context">

                    <div class="modern-appointment-avatar"
                         aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="8" />
                            <path d="M12 8v4l2.5 1.5" />
                        </svg>
                    </div>

                    <div class="modern-appointment-doctor">
                        <strong>@Model.DoctorName</strong>
                        <span>@Model.Specialty</span>
                    </div>

                    <div class="modern-appointment-date">
                        <strong>
                            @Model.AppointmentDate.ToString(
                            "ddd, dd MMM",
                                                        greekCulture)
                        </strong>

                        <span>
                            @Model.AppointmentDate.ToString("HH:mm")
                        </span>
                    </div>

                </div>

                <form method="post"
                      class="modern-cancel-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div>
                        <label asp-for="CancellationReason"
                               class="form-label form-label-custom">
                            Λόγος
                        </label>

                        <textarea asp-for="CancellationReason"
                                  class="form-control form-control-custom textarea-custom"
                                  rows="4"
                                  maxlength="600"
                                  placeholder="Π.χ. αλλαγή προγράμματος, προσωπικός λόγος..."></textarea>

                        <span asp-validation-for="CancellationReason"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="modern-cancel-hint">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5" />
                            <path d="M12 8h.01" />
                        </svg>

                        <span>
                            Ο ιατρός θα ενημερωθεί.
                        </span>
                    </div>

                    <div class="modern-form-actions">

                        <button type="submit"
                                class="btn btn-danger-custom">
                            Ακύρωση ραντεβού
                        </button>

                        <a asp-controller="Appointments"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-dashboard">
                            Πίσω
                        </a>

                    </div>

                </form>

            </section>

        </div>

    </div>
</section>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}