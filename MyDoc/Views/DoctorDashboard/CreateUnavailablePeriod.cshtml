@model MyDoc.Models.DoctorUnavailablePeriodVM

@{
    ViewData["Title"] = "Νέα Απουσία";
}

<section class="dashboard-page doctor-dashboard-page doctor-schedule-form-page">
    <div class="container">

        <div class="doctor-schedule-form-header">
            <a asp-action="Schedule" class="appointment-back-link">
                ← Πρόγραμμα
            </a>

            <div class="doctor-schedule-form-title">
                <div class="doctor-schedule-form-icon doctor-schedule-form-icon-away">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="3" y="4" width="18" height="17" rx="3"></rect>
                        <path d="M8 2.5v4"></path>
                        <path d="M16 2.5v4"></path>
                        <path d="M3 9h18"></path>
                        <path d="M9 13l6 6"></path>
                        <path d="M15 13l-6 6"></path>
                    </svg>
                </div>

                <div>
                    <span class="doctor-schedule-form-kicker">
                        Εξαίρεση προγράμματος
                    </span>

                    <h1>Νέα απουσία</h1>

                    <p>
                        Δηλώστε συγκεκριμένη ημερομηνία και ώρες στις οποίες δεν θα είστε διαθέσιμος.
                    </p>
                </div>
            </div>
        </div>

        <section class="doctor-schedule-form-card doctor-schedule-form-card-single">
            <form asp-action="CreateUnavailablePeriod" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger doctor-schedule-validation">
                </div>

                <div class="doctor-schedule-fields">

                    <div class="doctor-schedule-field doctor-schedule-field-full">
                        <div class="doctor-schedule-label-row">
                            <label asp-for="Date"
                                   class="form-label form-label-custom">
                                Ημερομηνία
                            </label>

                            <div class="doctor-inline-help">
                                <button type="button"
                                        class="doctor-inline-help-trigger"
                                        aria-label="Πληροφορίες για την απουσία">
                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.9"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <path d="M12 10v6"></path>
                                        <path d="M12 7h.01"></path>
                                    </svg>
                                </button>

                                <div class="doctor-inline-help-popover"
                                     role="tooltip">
                                    Η απουσία αφορά μόνο τη συγκεκριμένη ημερομηνία και ώρα.
                                    Το εβδομαδιαίο πρόγραμμά σας δεν αλλάζει.
                                </div>
                            </div>
                        </div>

                        <input asp-for="Date"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control form-control-custom" />

                        <span asp-validation-for="Date"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="doctor-schedule-field">
                        <label asp-for="StartTime"
                               class="form-label form-label-custom">
                            Από
                        </label>

                        <input asp-for="StartTime"
                               type="time"
                               class="form-control form-control-custom" />

                        <span asp-validation-for="StartTime"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="doctor-schedule-field">
                        <label asp-for="EndTime"
                               class="form-label form-label-custom">
                            Έως
                        </label>

                        <input asp-for="EndTime"
                               type="time"
                               class="form-control form-control-custom" />

                        <span asp-validation-for="EndTime"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="doctor-schedule-field doctor-schedule-field-full">
                        <label asp-for="Reason"
                               class="form-label form-label-custom">
                            Λόγος
                            <span class="doctor-field-optional">
                                Προαιρετικό
                            </span>
                        </label>

                        <textarea asp-for="Reason"
                                  class="form-control form-control-custom textarea-custom"
                                  rows="4"
                                  placeholder="Π.χ. προσωπική υποχρέωση, άδεια, έκτακτη απουσία..."></textarea>

                        <span asp-validation-for="Reason"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div id="unavailablePeriodWarning"
                     class="doctor-schedule-warning-card doctor-schedule-warning-dismissible">

                    <div class="doctor-schedule-warning-icon" aria-hidden="true">
                        !
                    </div>

                    <div class="doctor-schedule-warning-content">
                        <strong>
                            Η απουσία μπορεί να επηρεάσει υπάρχοντα ραντεβού
                        </strong>

                        <p>
                            Αν υπάρχουν ενεργά ραντεβού μέσα σε αυτό το χρονικό διάστημα,
                            θα ακυρωθούν αυτόματα και οι ασθενείς θα ενημερωθούν.
                        </p>
                    </div>

                    <button type="button"
                            id="dismissUnavailablePeriodWarning"
                            class="doctor-schedule-warning-dismiss"
                            aria-label="Κλείσιμο προειδοποίησης"
                            title="Κλείσιμο">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             aria-hidden="true">
                            <path d="M6 6l12 12"></path>
                            <path d="M18 6L6 18"></path>
                        </svg>
                    </button>
                </div>

                <div class="doctor-schedule-form-actions">
                    <button type="submit" class="btn btn-primary-custom">
                        Καταχώριση απουσίας
                    </button>

                    <a asp-action="Schedule"
                       class="btn btn-outline-dashboard">
                        Ακύρωση
                    </a>
                </div>
            </form>
        </section>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const warning = document.getElementById("unavailablePeriodWarning");
            const dismissButton = document.getElementById("dismissUnavailablePeriodWarning");

            if (warning && dismissButton) {
                dismissButton.addEventListener("click", function () {
                    warning.remove();
                });
            }
        });
    </script>
}