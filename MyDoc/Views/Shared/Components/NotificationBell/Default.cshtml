@model int

<li class="nav-item">
    <a class="nav-link notification-nav-link"
       asp-controller="Notifications"
       asp-action="Index"
       title="Ειδοποιήσεις"
       aria-label="Ειδοποιήσεις">

        <svg class="notification-bell-icon"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.9"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">

            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9">
            </path>

            <path d="M10 21h4">
            </path>

        </svg>

        @if (Model > 0)
        {
            <span class="notification-badge @(Model > 9 ? "notification-badge-wide" : "")">
                @(Model > 99
                            ? "99+"
                            : Model.ToString())
            </span>
        }

    </a>
</li>
