@if (!(User.Identity?.IsAuthenticated == true && User.IsInRole("Doctor")))
{
<section id="doctors" class="section-block">
    <div class="container">
        <div class="section-heading text-center">
            <h2>Αναζήτηση Ιατρού</h2>
            <p>Βρείτε ενεργούς ιατρούς ανά όνομα ή ειδικότητα και δείτε την επόμενη διαθέσιμη ώρα.</p>
        </div>

        <div class="dashboard-content-card mb-4">
                <div class="dashboard-content-card mb-4">
                    <form id="doctorSearchForm">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label for="doctorSearchInput"
                                       class="form-label form-label-custom">
                                    Αναζήτηση
                                </label>

                                <input id="doctorSearchInput"
                                       type="text"
                                       name="search"
                                       value="@Model.Search"
                                       class="form-control form-control-custom"
                                       placeholder="Όνομα, επίθετο ή ειδικότητα" />
                            </div>

                            <div class="col-md-4">
                                <label for="doctorSpecialtySelect"
                                       class="form-label form-label-custom">
                                    Ειδικότητα
                                </label>

                                <select id="doctorSpecialtySelect"
                                        name="specialty"
                                        class="form-select form-control-custom">

                                    <option value="">Όλες οι ειδικότητες</option>

                                    @foreach (var specialty in Model.Specialties)
                                    {
                                        if (Model.Specialty == specialty)
                                        {
                                            <option value="@specialty" selected>
                                                @specialty
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@specialty">
                                                @specialty
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <button id="doctorSearchButton"
                                        type="submit"
                                        class="btn btn-primary-custom w-100">
                                    Αναζήτηση
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
        </div>

            <div class="home-doctor-results-shell">

                <div id="doctorSearchLoading"
                     class="home-doctor-search-loader"
                     hidden>

                    <div class="home-doctor-search-spinner"
                         aria-hidden="true">
                    </div>

                    <span>Αναζήτηση διαθέσιμων ιατρών...</span>
                </div>


                <div id="doctorSearchEmpty"
                     class="empty-state-box home-doctor-search-empty"
                     @(Model.Doctors.Any() ? "hidden" : "")>

                    <h3>Δεν βρέθηκαν ιατροί</h3>

                    <p>
                        Δοκιμάστε διαφορετικό όνομα ή ειδικότητα.
                    </p>
                </div>


                <div id="doctorResultsViewport"
                     class="home-doctor-results-viewport">

                    <div id="doctorSearchResults"
                         class="row g-4 home-doctor-results-grid">

                        @foreach (var doctor in Model.Doctors)
                        {
                            <div class="col-md-6 col-xl-3 doctor-search-result">
                                <div class="feature-card">
                                    <div class="feature-icon">
                                        Dr
                                    </div>

                                    <h4>@doctor.FullName</h4>

                                    <p class="mb-2">
                                        <strong>@doctor.Specialty</strong>
                                    </p>

                                    @if (doctor.NextAvailableSlot.HasValue)
                                    {
                                        <p>
                                            Επόμενη διαθέσιμη ώρα:
                                            <br />

                                            <strong>
                                                @doctor.NextAvailableSlot.Value.ToString("dd/MM/yyyy HH:mm")
                                            </strong>
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            Δεν βρέθηκε διαθέσιμη ώρα τις επόμενες 14 ημέρες.
                                        </p>
                                    }

                                    <div class="mt-3">
                                        <a asp-area="Identity"
                                           asp-page="/Account/Login"
                                           class="btn btn-primary-custom w-100">
                                            Σύνδεση για Ραντεβού
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>


                <div id="doctorSearchNavigation"
                     class="home-doctor-search-navigation"
                     hidden>

                    <button id="doctorSearchPrevious"
                            type="button"
                            class="home-doctor-search-arrow"
                            aria-label="Προηγούμενα αποτελέσματα">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M15 18l-6-6 6-6"></path>
                        </svg>
                    </button>


                    <span id="doctorSearchPageIndicator"
                          class="home-doctor-search-page">
                    </span>


                    <button id="doctorSearchNext"
                            type="button"
                            class="home-doctor-search-arrow"
                            aria-label="Επόμενα αποτελέσματα">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M9 18l6-6-6-6"></path>
                        </svg>
                    </button>

                </div>

            </div>

    </div>
</section>
}

