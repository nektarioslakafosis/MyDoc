@model MyDoc.Models.HomeIndexVM
@using MyDoc.Models

@{
    ViewData["Title"] = "Αρχική";

    string GetStatusClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Pending => "status-badge status-pending",
        AppointmentStatus.Approved => "status-badge status-approved",
        AppointmentStatus.Cancelled => "status-badge status-cancelled",
        AppointmentStatus.Expired => "status-badge status-expired",
        AppointmentStatus.Completed => "status-badge status-approved",
        AppointmentStatus.NoShow => "status-badge status-cancelled",
        _ => "status-badge"
    };
}

<section class="hero-section">
    <div class="hero-overlay"></div>

    <div class="container hero-content">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="hero-badge">Σύστημα Ραντεβού MyDoc</span>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Patient"))
                    {
                        <h1 class="hero-title">Καλώς ήρθατε πίσω στο MyDoc</h1>
                        <p class="hero-text">
                            Δείτε το επόμενο ραντεβού σας, συμπληρώστε τις απαραίτητες πληροφορίες
                            και κλείστε νέο ραντεβού με διαθέσιμο ιατρό.
                        </p>
                    }
                    else if (User.IsInRole("Doctor"))
                    {
                        <h1 class="hero-title">Η σημερινή σας εικόνα με μια ματιά</h1>
                        <p class="hero-text">
                            Ελέγξτε τα σημερινά ραντεβού, τα pending αιτήματα και τις αλλαγές ραντεβού
                            που χρειάζονται απάντηση.
                        </p>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <h1 class="hero-title">Κεντρική εικόνα λειτουργίας MyDoc</h1>
                        <p class="hero-text">
                            Γρήγορη πρόσβαση στη διαχείριση γιατρών, ασθενών και ραντεβού.
                        </p>
                    }
                }
                else
                {
                    <h1 class="hero-title">Βρείτε ιατρό και κλείστε ραντεβού πιο εύκολα</h1>
                    <p class="hero-text">
                        Αναζητήστε διαθέσιμους ιατρούς ανά όνομα ή ειδικότητα και δείτε γρήγορα
                        πότε υπάρχει διαθέσιμη ώρα για ραντεβού.
                    </p>
                }

                <div class="hero-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Patient"))
                        {
                            <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary-custom btn-lg me-2 mb-2">
                                Νέο Ραντεβού
                            </a>

                            <a asp-controller="PatientDashboard" asp-action="Index" class="btn btn-outline-light-custom btn-lg mb-2">
                                Τα Ραντεβού μου
                            </a>
                        }
                        else if (User.IsInRole("Doctor"))
                        {
                            <a asp-controller="DoctorDashboard" asp-action="Index" class="btn btn-primary-custom btn-lg me-2 mb-2">
                                Ραντεβού Ιατρού
                            </a>

                            <a asp-controller="DoctorDashboard" asp-action="Schedule" class="btn btn-outline-light-custom btn-lg mb-2">
                                Το Πρόγραμμά μου
                            </a>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-primary-custom btn-lg me-2 mb-2">
                                Admin Dashboard
                            </a>

                            <a asp-controller="Doctors" asp-action="Create" class="btn btn-outline-light-custom btn-lg mb-2">
                                Νέος Γιατρός
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary-custom btn-lg me-2 mb-2">
                            Σύνδεση
                        </a>

                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light-custom btn-lg mb-2">
                            Εγγραφή Ασθενή
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@if (User.Identity?.IsAuthenticated == true)
