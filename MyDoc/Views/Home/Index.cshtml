<section class="section-block contact-strip">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <h2>Επικοινωνία & Υποστήριξη</h2>
                <p class="mb-0">
                    Για πληροφορίες σχετικά με τη χρήση της πλατφόρμας ή τη διαχείριση ραντεβού,
                    μπορείτε να επικοινωνήσετε με την υποστήριξη.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn btn-primary-custom">
                    Επικοινωνία
                </a>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("doctorSearchForm");

            if (!form) {
                return;
            }

            const searchInput =
                document.getElementById("doctorSearchInput");

            const specialtySelect =
                document.getElementById("doctorSpecialtySelect");

            const searchButton =
                document.getElementById("doctorSearchButton");

            const resultsViewport =
                document.getElementById("doctorResultsViewport");

            const resultsContainer =
                document.getElementById("doctorSearchResults");

            const emptyState =
                document.getElementById("doctorSearchEmpty");

            const loadingState =
                document.getElementById("doctorSearchLoading");

            const navigation =
                document.getElementById("doctorSearchNavigation");

            const previousButton =
                document.getElementById("doctorSearchPrevious");

            const nextButton =
                document.getElementById("doctorSearchNext");

            const pageIndicator =
                document.getElementById("doctorSearchPageIndicator");

            let currentPage = 1;
            let isLoading = false;


            form.addEventListener("submit", async function (event) {
                event.preventDefault();

                currentPage = 1;

                await loadDoctors();
            });


            previousButton.addEventListener("click", async function () {

                if (isLoading || currentPage <= 1) {
                    return;
                }

                currentPage--;

                await loadDoctors("previous");
            });


            nextButton.addEventListener("click", async function () {

                if (isLoading) {
                    return;
                }

                currentPage++;

                await loadDoctors("next");
            });


            async function loadDoctors(direction = "search") {

                if (isLoading) {
                    return;
                }

                isLoading = true;

                const search =
                    searchInput.value.trim();

                const specialty =
                    specialtySelect.value;

                const params =
                    new URLSearchParams();

                if (search) {
                    params.set("search", search);
                }

                if (specialty) {
                    params.set("specialty", specialty);
                }

                params.set(
                    "page",
                    currentPage.toString()
                );

                const loadingStartedAt =
                    performance.now();

                searchButton.disabled = true;
                previousButton.disabled = true;
                nextButton.disabled = true;

                /*
                 * Πρώτα εξαφανίζουμε ομαλά
                 * την υπάρχουσα τετράδα.
                 */
                resultsViewport.classList.add(
                    "is-leaving"
                );

                navigation.classList.add(
                    "is-hidden"
                );

                await wait(180);

                resultsViewport.hidden = true;
                emptyState.hidden = true;

                loadingState.hidden = false;

                requestAnimationFrame(function () {
                    loadingState.classList.add(
                        "is-visible"
                    );
                });


                try {

                    const response = await fetch(
                        '@Url.Action("SearchDoctors", "Home")?' +
                        params.toString(),
                        {
                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        }
                    );

                    if (!response.ok) {
                        throw new Error(
                            "Η αναζήτηση δεν ολοκληρώθηκε."
                        );
                    }

                    const data =
                        await response.json();


                    /*
                     * Αποφεύγουμε το πολύ γρήγορο flash
                     * του loader όταν η απάντηση έρθει
                     * σχεδόν αμέσως.
                     */
                    const elapsed =
                        performance.now() -
                        loadingStartedAt;

                    const minimumLoadingTime = 450;

                    if (elapsed < minimumLoadingTime) {
                        await wait(
                            minimumLoadingTime - elapsed
                        );
                    }


                    loadingState.classList.remove(
                        "is-visible"
                    );

                    await wait(140);

                    loadingState.hidden = true;


                    resultsContainer.innerHTML = "";

                    if (!data.doctors.length) {

                        currentPage = 1;

                        emptyState.hidden = false;

                        navigation.hidden = true;

                        updateAddressBar(
                            search,
                            specialty
                        );

                        return;
                    }


                    data.doctors.forEach(
                        function (doctor) {

                            resultsContainer.appendChild(
                                createDoctorCard(doctor)
                            );

                        }
                    );


                    /*
                     * Ο server μπορεί να διορθώσει το page
                     * αν ζητήσαμε αριθμό εκτός ορίων.
                     */
                    currentPage = data.page;


                    resultsViewport.hidden = false;

                    resultsViewport.classList.remove(
                        "is-leaving",
                        "is-entering",
                        "from-left",
                        "from-right"
                    );


                    if (direction === "next") {
                        resultsViewport.classList.add(
                            "is-entering",
                            "from-right"
                        );
                    }
                    else if (direction === "previous") {
                        resultsViewport.classList.add(
                            "is-entering",
                            "from-left"
                        );
                    }
                    else {
                        resultsViewport.classList.add(
                            "is-entering"
                        );
                    }


                    requestAnimationFrame(function () {

                        requestAnimationFrame(function () {

                            resultsViewport.classList.remove(
                                "is-entering",
                                "from-left",
                                "from-right"
                            );

                        });

                    });


                    updateNavigation(data);

                    updateAddressBar(
                        search,
                        specialty
                    );
                }
                catch (error) {

                    loadingState.classList.remove(
                        "is-visible"
                    );

                    await wait(120);

                    loadingState.hidden = true;

                    resultsContainer.innerHTML = "";
                    resultsViewport.hidden = true;

                    emptyState.hidden = false;

                    emptyState.querySelector("h3")
                        .textContent =
                        "Δεν ήταν δυνατή η αναζήτηση";

                    emptyState.querySelector("p")
                        .textContent =
                        "Δοκιμάστε ξανά σε λίγο.";

                    navigation.hidden = true;
                }
                finally {

                    searchButton.disabled = false;
                    previousButton.disabled = false;
                    nextButton.disabled = false;

                    isLoading = false;
                }
            }


            function updateNavigation(data) {

                const hasNavigation =
                    data.totalPages > 1 &&
                    (
                        searchInput.value.trim() ||
                        specialtySelect.value
                    );

                navigation.hidden =
                    !hasNavigation;

                if (!hasNavigation) {
                    return;
                }

                previousButton.disabled =
                    !data.hasPrevious;

                nextButton.disabled =
                    !data.hasNext;

                pageIndicator.textContent =
                    data.page +
                    " / " +
                    data.totalPages;

                navigation.classList.remove(
                    "is-hidden"
                );
            }


            function createDoctorCard(doctor) {

                const column =
                    document.createElement("div");

                column.className =
                    "col-md-6 col-xl-3 doctor-search-result";


                const card =
                    document.createElement("div");

                card.className =
                    "feature-card";


                const icon =
                    document.createElement("div");

                icon.className =
                    "feature-icon";

                icon.textContent = "Dr";


                const name =
                    document.createElement("h4");

                name.textContent =
                    doctor.fullName;


                const specialtyText =
                    document.createElement("p");

                specialtyText.className = "mb-2";


                const specialtyStrong =
                    document.createElement("strong");

                specialtyStrong.textContent =
                    doctor.specialty;

                specialtyText.appendChild(
                    specialtyStrong
                );


                const availability =
                    document.createElement("p");


                if (doctor.nextAvailableSlot) {

                    availability.append(
                        document.createTextNode(
                            "Επόμενη διαθέσιμη ώρα:"
                        )
                    );

                    availability.appendChild(
                        document.createElement("br")
                    );

                    const date =
                        document.createElement("strong");

                    date.textContent =
                        doctor.nextAvailableSlot;

                    availability.appendChild(date);
                }
                else {

                    availability.textContent =
                        "Δεν βρέθηκε διαθέσιμη ώρα τις επόμενες 14 ημέρες.";
                }


                const action =
                    document.createElement("div");

                action.className = "mt-3";


                const login =
                    document.createElement("a");

                login.href =
                    "/Identity/Account/Login";

                login.className =
                    "btn btn-primary-custom w-100";

                login.textContent =
                    "Σύνδεση για Ραντεβού";


                action.appendChild(login);

                card.appendChild(icon);
                card.appendChild(name);
                card.appendChild(specialtyText);
                card.appendChild(availability);
                card.appendChild(action);

                column.appendChild(card);

                return column;
            }


            function updateAddressBar(
                search,
                specialty
            ) {

                const url =
                    new URL(window.location.href);

                url.searchParams.delete("search");
                url.searchParams.delete("specialty");

                if (search) {
                    url.searchParams.set(
                        "search",
                        search
                    );
                }

                if (specialty) {
                    url.searchParams.set(
                        "specialty",
                        specialty
                    );
                }

                url.hash = "doctors";

                history.replaceState(
                    null,
                    "",
                    url.pathname +
                    url.search +
                    url.hash
                );
            }


            function wait(milliseconds) {

                return new Promise(function (resolve) {
                    setTimeout(resolve, milliseconds);
                });
            }

        });
    </script>
}