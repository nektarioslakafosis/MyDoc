@page
@model MyDoc.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Ο κωδικός άλλαξε";
}

<section class="identity-flow-page">
    <div class="container">

        <div class="identity-flow-card">

            <div class="identity-flow-icon is-success">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8 12.5l2.5 2.5L16 9"></path>
                </svg>
            </div>

            <span class="identity-flow-kicker">
                ΟΛΟΚΛΗΡΩΘΗΚΕ
            </span>

            <h1>Ο νέος κωδικός αποθηκεύτηκε</h1>

            <p class="identity-flow-lead">
                Μπορείτε πλέον να συνδεθείτε
                χρησιμοποιώντας τον νέο κωδικό σας.
            </p>

            <div class="identity-flow-actions">
                <a asp-page="./Login"
                   class="btn btn-primary-custom">
                    Σύνδεση
                </a>
            </div>

        </div>

    </div>
</section>