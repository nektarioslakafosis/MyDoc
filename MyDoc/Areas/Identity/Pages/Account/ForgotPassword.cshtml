@page
@model MyDoc.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Επαναφορά κωδικού";
}

<section class="identity-flow-page">
    <div class="container">

        <div class="identity-flow-card identity-flow-card-form">

            <div class="identity-flow-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                </svg>
            </div>

            <span class="identity-flow-kicker">
                ΑΣΦΑΛΕΙΑ ΛΟΓΑΡΙΑΣΜΟΥ
            </span>

            <h1>Ξεχάσατε τον κωδικό;</h1>

            <p class="identity-flow-lead">
                Θα σας στείλουμε σύνδεσμο για να ορίσετε νέο κωδικό.
            </p>

            <form method="post"
                  class="identity-flow-form">

                <div asp-validation-summary="ModelOnly"
                     class="identity-form-validation text-danger">
                </div>

                <div class="identity-form-field">
                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           class="identity-form-input"
                           autocomplete="email"
                           placeholder="name@example.com" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary-custom">
                    Αποστολή συνδέσμου
                </button>

            </form>

            <a asp-page="./Login"
               class="identity-flow-link">
                Πίσω στη σύνδεση
            </a>

        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}