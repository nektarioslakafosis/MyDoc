@page
@model MyDoc.Areas.Identity.Pages.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Νέος κωδικός";
}

<section class="identity-flow-page">
    <div class="container">

        <div class="identity-flow-card identity-flow-card-form">

            <div class="identity-flow-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="8.5" cy="11.5" r="4.5" />
                    <path d="M13 11.5h7.5" />
                    <path d="M17 11.5v3" />
                    <path d="M20 11.5v2" />
                </svg>
            </div>

            <span class="identity-flow-kicker">
                ΑΣΦΑΛΕΙΑ ΛΟΓΑΡΙΑΣΜΟΥ
            </span>

            <h1>Ορίστε νέο κωδικό</h1>

            <p class="identity-flow-lead">
                Συμπληρώστε το email σας και επιλέξτε νέο κωδικό.
            </p>

            <form method="post"
                  class="identity-flow-form">

                <div asp-validation-summary="ModelOnly"
                     class="identity-form-validation text-danger">
                </div>

                <input asp-for="Input.Code"
                       type="hidden" />

                <div class="identity-form-field">
                    <label asp-for="Input.Email">Email</label>

                    <input asp-for="Input.Email"
                           class="identity-form-input"
                           autocomplete="email"
                           placeholder="name@example.com" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="identity-form-field">
                    <label asp-for="Input.Password">
                        Νέος κωδικός
                    </label>

                    <input asp-for="Input.Password"
                           class="identity-form-input"
                           autocomplete="new-password"
                           placeholder="Νέος κωδικός" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="identity-form-field">
                    <label asp-for="Input.ConfirmPassword">
                        Επιβεβαίωση κωδικού
                    </label>

                    <input asp-for="Input.ConfirmPassword"
                           class="identity-form-input"
                           autocomplete="new-password"
                           placeholder="Επαναλάβετε τον νέο κωδικό" />

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary-custom">
                    Αποθήκευση νέου κωδικού
                </button>

            </form>

        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}