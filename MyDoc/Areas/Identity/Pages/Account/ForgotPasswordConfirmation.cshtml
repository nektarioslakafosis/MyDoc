@page
@model MyDoc.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Ελέγξτε το email σας";
}

<section class="identity-flow-page">
    <div class="container">

        <div class="identity-flow-card">

            <div class="identity-flow-icon is-success">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="3"></rect>
                    <path d="m4 7 8 6 8-6"></path>
                </svg>
            </div>

            <span class="identity-flow-kicker">
                EMAIL ΑΠΕΣΤΑΛΗ
            </span>

            <h1>Ελέγξτε το email σας</h1>

            <p class="identity-flow-lead">
                Αν υπάρχει ενεργός λογαριασμός με αυτό το email,
                θα λάβετε σύνδεσμο επαναφοράς κωδικού.
            </p>

            <p class="identity-flow-muted">
                Ελέγξτε και τον φάκελο ανεπιθύμητης αλληλογραφίας
                αν δεν εμφανιστεί το μήνυμα.
            </p>

            <div class="identity-flow-actions">
                <a asp-page="./Login"
                   class="btn btn-primary-custom">
                    Πίσω στη σύνδεση
                </a>
            </div>

        </div>

    </div>
</section>