@page

@{
    ViewData["Title"] = "Δεν επιτρέπεται η πρόσβαση";
}

<section class="identity-flow-page">
    <div class="container">

        <div class="identity-flow-card">

            <div class="identity-flow-icon is-danger">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8.5 8.5l7 7"></path>
                </svg>
            </div>

            <span class="identity-flow-kicker">
                ΠΡΟΣΒΑΣΗ
            </span>

            <h1>Δεν έχετε πρόσβαση σε αυτή τη σελίδα</h1>

            <p class="identity-flow-lead">
                Ο λογαριασμός σας δεν έχει δικαίωμα
                πρόσβασης σε αυτό το σημείο της εφαρμογής.
            </p>

            <div class="identity-flow-actions">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary-custom">
                    Αρχική
                </a>
            </div>

        </div>

    </div>
</section>
