@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Αλλαγή κωδικού";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;

    var backController =
    User.IsInRole("Doctor")
        ? "DoctorDashboard"
        : User.IsInRole("Admin")
            ? "Appointments"
            : "PatientDashboard";
}

<section class="dashboard-page account-settings-page">
    <div class="container">

        <div class="account-settings-page-header">

            <a asp-area=""
               asp-controller="@backController"
               asp-action="Index"
               class="appointment-back-link">
                ← Ραντεβού
            </a>

            <h1>Ρυθμίσεις</h1>
        </div>

        <div class="account-settings-shell">

            <aside class="account-settings-sidebar">

                <div class="account-security-sidebar-heading">

                    <div class="account-security-sidebar-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <rect x="4" y="10" width="16" height="11" rx="3"></rect>
                            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                        </svg>
                    </div>

                    <div>
                        <strong>Λογαριασμός</strong>
                        <span>@User.Identity?.Name</span>
                    </div>

                </div>

                <partial name="_ManageNav" />

            </aside>

            <main class="account-settings-content">

                <div class="account-settings-content-header">
                    <div>
                        <h2>Αλλαγή κωδικού</h2>
                        <p>
                            Χρησιμοποιήστε τον τρέχοντα κωδικό σας
                            για να ορίσετε έναν νέο.
                        </p>
                    </div>
                </div>

                <partial name="_StatusMessage"
                         for="StatusMessage" />

                <form id="change-password-form"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger account-settings-validation"
                         role="alert">
                    </div>

                    <div class="account-security-form">

                        <div class="account-settings-field">
                            <label asp-for="Input.OldPassword">
                                Τρέχων κωδικός
                            </label>

                            <input asp-for="Input.OldPassword"
                                   class="form-control account-settings-input"
                                   autocomplete="current-password"
                                   placeholder="Τρέχων κωδικός" />

                            <span asp-validation-for="Input.OldPassword"
                                  class="text-danger"></span>
                        </div>

                        <div class="account-settings-field">
                            <label asp-for="Input.NewPassword">
                                Νέος κωδικός
                            </label>

                            <input asp-for="Input.NewPassword"
                                   class="form-control account-settings-input"
                                   autocomplete="new-password"
                                   placeholder="Νέος κωδικός" />

                            <span asp-validation-for="Input.NewPassword"
                                  class="text-danger"></span>
                        </div>

                        <div class="account-settings-field">
                            <label asp-for="Input.ConfirmPassword">
                                Επιβεβαίωση νέου κωδικού
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control account-settings-input"
                                   autocomplete="new-password"
                                   placeholder="Επαναλάβετε τον νέο κωδικό" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="account-settings-actions">
                        <button type="submit"
                                class="btn btn-primary-custom">
                            Αποθήκευση νέου κωδικού
                        </button>
                    </div>

                </form>

            </main>

        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}