@page
@model MyDoc.Areas.Identity.Pages.Account.ResendEmailConfirmationModel

@{
    ViewData["Title"] = "Νέα αποστολή επιβεβαίωσης";
}

<section class="identity-flow-page">
    <div class="container">

        <div class="identity-flow-card identity-flow-card-form">

            <div class="identity-flow-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3.5" y="5.5" width="17" height="13" rx="2.5" />
                    <path d="M5 8l7 5 7-5" />
                </svg>
            </div>

            <span class="identity-flow-kicker">
                ΕΠΙΒΕΒΑΙΩΣΗ EMAIL
            </span>

            <h1>Στείλτε νέο σύνδεσμο</h1>

            <p class="identity-flow-lead">
                Συμπληρώστε το email του λογαριασμού σας.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="account-inline-status is-info">
                    @Model.StatusMessage
                </div>
            }

            <form method="post"
                  class="identity-flow-form">

                <div asp-validation-summary="ModelOnly"
                     class="identity-form-validation text-danger">
                </div>

                <div class="identity-form-field">
                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           class="identity-form-input"
                           autocomplete="email"
                           placeholder="name@example.com" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary-custom">
                    Αποστολή
                </button>

            </form>

            <a asp-page="./Login"
               class="identity-flow-link">
                Πίσω στη σύνδεση
            </a>

        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}