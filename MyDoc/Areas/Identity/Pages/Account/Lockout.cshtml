@page
@model MyDoc.Areas.Identity.Pages.Account.LockoutModel

@{
    ViewData["Title"] = "Ο λογαριασμός δεν είναι διαθέσιμος";
}

<section class="identity-flow-page">
    <div class="container">

        <div class="identity-flow-card">

            <div class="identity-flow-icon is-danger">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                </svg>
            </div>

            <span class="identity-flow-kicker">
                ΛΟΓΑΡΙΑΣΜΟΣ
            </span>

            <h1>Δεν είναι δυνατή η σύνδεση</h1>

            <p class="identity-flow-lead">
                Ο λογαριασμός δεν είναι αυτή τη στιγμή διαθέσιμος.
            </p>

            <p class="identity-flow-muted">
                Αν θεωρείτε ότι πρόκειται για λάθος,
                επικοινωνήστε με την υποστήριξη.
            </p>

            <div class="identity-flow-actions">
                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn btn-primary-custom">
                    Επικοινωνία
                </a>

                <a asp-page="./Login"
                   class="identity-flow-link">
                    Πίσω στη σύνδεση
                </a>
            </div>

        </div>

    </div>
</section>
